function(fatfs_value name value)
  string(REGEX REPLACE "(#[ \t]*define[ \t]+${name}[ \t]+)[0-9]+" "\\1${value}" config "${config}")
  set(config "${config}" PARENT_SCOPE)
endfunction()

function(attach_sky_fatfs target)
  set(fatfs "${CUBE_F4_ROOT}/Middlewares/Third_Party/FatFs/src")
  set(hal "${CUBE_F4_ROOT}/Drivers/STM32F4xx_HAL_Driver")
  file(READ "${fatfs}/ffconf_template.h" config)
  fatfs_value(_USE_MKFS 0)
  fatfs_value(_USE_FASTSEEK 0)
  fatfs_value(_USE_LFN 0)
  fatfs_value(_CODE_PAGE 437)
  fatfs_value(_VOLUMES 1)
  fatfs_value(_FS_NORTC 1)
  fatfs_value(_NORTC_YEAR 2026)
  fatfs_value(_FS_LOCK 0)
  file(CONFIGURE OUTPUT ffconf.h CONTENT "${config}" @ONLY)
  target_sources(${target} PRIVATE "${fatfs}/ff.c" "${hal}/Src/stm32f4xx_ll_sdmmc.c"
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/sdio_disk.c")
  target_include_directories(${target} PRIVATE "${fatfs}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
endfunction()
